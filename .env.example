# ---- copy to .env and fill in. NEVER commit .env ----

# OpenAI (credit code redeemed at platform.openai.com/settings/organization/billing)
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o

# TwelveLabs (https://playground.twelvelabs.io -> API Key)
TWELVELABS_API_KEY=tlk_...
TWELVELABS_INDEX_ID=

# Neo4j — use Aura Free so both teammates share one graph.
# Aura: https://console.neo4j.io  (URI looks like neo4j+s://xxxx.databases.neo4j.io)
# NOTE: some Aura instances use the instance id as BOTH username and database
# name (not "neo4j") — check the credentials file you downloaded.
# Local docker alternative: bolt://localhost:7687 / neo4j / hackathon123 / neo4j
NEO4J_URI=neo4j+s://xxxxxxx.databases.neo4j.io
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=
NEO4J_DATABASE=neo4j

# Twitch (register an app at https://dev.twitch.tv/console/apps — free, 2 minutes)
# OAuth Redirect URL can be http://localhost — we only use app access tokens.
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# AWS — at an AWS event, open Workshop Studio -> "Get AWS CLI credentials"
# and paste all THREE values (the session token is required for temp creds).
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
AWS_ACCOUNT_ID=
S3_BUCKET=

# Optional Bedrock overrides (region-prefixed inference profiles)
BEDROCK_MODEL_ID=us.anthropic.claude-sonnet-4-20250514-v1:0
BEDROCK_PEGASUS_MODEL=us.twelvelabs.pegasus-1-2-v1:0

# Which model backend the Strands agent uses: "openai" or "bedrock"
AGENT_BACKEND=openai
